<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" "http://www.w3.org/TR/REC-html40/loose.dtd">
<html><head><meta charset="UTF-8"></head><body><p>{% set default_tab_index = settings['default-active-tab'] | default(0) %}
{% set default_active_tab_id = id ~ '-tab-' ~ default_tab_index %}
{% set e_settings = {
    'default-active-tab': default_active_tab_id,
} %}
{% set classes = ['e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
</p><div class="{{ classes }} {{ editor_classes | default('') }}" data-id="{{ id }}" data-element_type="{{ type }}" data-e-type="{{ type }}" data-interaction-id="{{ interaction_id }}" data-interactions="{{ interactions | json_encode | e('html_attr') }}" x-data="eTabs{{ id }}" data-e-settings="{{ e_settings | json_encode | e('html_attr') }}" if settings._cssid is defined and not empty id="{{ settings._cssid | e('html_attr') }}" endif settings.attributes raw editor_attributes default>
    <!-- elementor-children-placeholder -->
</div>
		
</body></html>
